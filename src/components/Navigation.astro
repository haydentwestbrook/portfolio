---
// Define the static links manually
const navLinks = [
  { name: "About me", url: "/" },
  { name: "Projects", url: "/projects" },
  { name: "Contact", url: "/contact" },
];
---

<nav class="bg-olive">
  <ul>
    {
      navLinks.map((link) => (
        <li>
          <a href={link.url}>{link.name}</a>
        </li>
      ))
    }
  </ul>
</nav>
