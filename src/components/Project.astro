---
// Define props for the project component
export interface Props {
  name: string;
  description: string;
  link: string;
  image: string;
}

const { name, description, link, image } = Astro.props;
---

<div class="project">
  <img src={image} alt={name} class="project-image" />
  <h2>{name}</h2>
  <p>{description}</p>
  <a href={link} target="_blank">View Project</a>
</div>

<style>
  .project {
    border: 1px solid #ccc;
    padding: 16px;
    margin-bottom: 16px;
    border-radius: 8px;
  }
  .project-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  h2 {
    margin: 8px 0;
  }
  a {
    color: #007acc;
    text-decoration: none;
  }
</style>
