---
// Import the Layout component
import Layout from "../layouts/Layout.astro";
import { Footer } from "../components/Footer/Footer";

const title = "404 - Page Not Found";
const description = "The page you are looking for does not exist.";
---

<Layout title={title} description={description}>
  <main class="min-h-screen pt-16 pb-16 flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto">
      <h1 class="text-6xl font-bold text-gray-900 mb-4">404</h1>
      <div class="h-1 w-20 bg-primary mx-auto mb-8 rounded-full"></div>
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Page Not Found</h2>
      <p class="text-lg text-gray-600 mb-8">
    Sorry, the page you are looking for does not exist. It might have been moved
    or deleted.
  </p>
      <a
        href="/"
        class="inline-flex items-center px-6 py-3 text-base font-medium text-white bg-primary hover:bg-primary-dark rounded-lg transition-colors"
      >
        Return to Home
      </a>
    </div>
  </main>
  <Footer client:load />
</Layout>
