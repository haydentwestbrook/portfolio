---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Enhanced metadata for SEO
const title = post.data.title;
const description = post.data.description;
const pubDate = post.data.pubDate;
const modifiedDate = post.data.modifiedDate || pubDate;
const author = post.data.author;
const image = post.data.image;
const tags = post.data.tags || [];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Generate structured data for rich snippets
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": image,
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Hayden Westbrook",
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/logo.png", Astro.site).toString()
    }
  },
  "datePublished": pubDate.toISOString(),
  "dateModified": modifiedDate.toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.toString()
  }
};
---

<Layout 
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  image={image}
  type="article"
  pubDate={pubDate}
  modifiedDate={modifiedDate}
  author={author}
  tags={tags}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="mb-12 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6">
        {title}
      </h1>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 text-gray-600 mb-8">
        {author && (
          <div class="flex items-center">
            <span class="font-medium">{author}</span>
          </div>
        )}
        <div class="flex items-center">
          <time datetime={pubDate.toISOString()} class="font-medium">
            {formatDate(pubDate)}
          </time>
          {modifiedDate && modifiedDate > pubDate && (
            <span class="ml-2 text-sm">
              (Updated {formatDate(modifiedDate)})
            </span>
          )}
        </div>
      </div>

      {image && (
        <div class="relative w-full aspect-video mb-8 rounded-lg overflow-hidden">
          <img
            src={image}
            alt={title}
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      )}

      {tags.length > 0 && (
        <div class="flex flex-wrap justify-center gap-2 mb-8">
          {tags.map((tag: string) => (
            <span
              class="px-3 py-1 text-sm bg-primary/10 text-primary rounded-full"
            >
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-lg max-w-none prose-headings:font-bold prose-a:text-primary hover:prose-a:text-primary-dark">
      <Content />
    </div>

    <footer class="mt-12 pt-8 border-t border-gray-200">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
        <div class="text-sm text-gray-600">
          Last updated: {formatDate(modifiedDate)}
        </div>
        <div class="flex gap-4">
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalURL.toString())}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-600 hover:text-primary transition-colors"
          >
            Share on Twitter
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalURL.toString())}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-600 hover:text-primary transition-colors"
          >
            Share on LinkedIn
          </a>
        </div>
      </div>
    </footer>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</Layout>
