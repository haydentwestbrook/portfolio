---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import ProjectList from '../components/ProjectList/ProjectList';
import HeroImage from '../components/HeroImage/HeroImage';
import { getCollection } from 'astro:content';

// Fetch projects from content collection
const projects = (await getCollection('projects')).map(entry => ({
  title: entry.data.title,
  description: entry.data.description,
  image: entry.data.image,
  technologies: entry.data.technologies,
  liveUrl: entry.data.liveUrl,
  githubUrl: entry.data.githubUrl,
  date: entry.data.date
}));

// Generate metadata for SEO
const title = "Hayden Westbrook - Portfolio";
const description = "Software Developer & Engineer specializing in web development and software engineering.";

// Handle canonical URL based on environment
let canonicalURL;
try {
  if (Astro.site) {
    canonicalURL = new URL(Astro.url.pathname, Astro.site);
  }
} catch (error) {
  console.warn('Could not generate canonical URL:', error);
}

// Development-specific settings
const isDev = import.meta.env.DEV;
const imageUrl = isDev 
  ? "https://placehold.co/1200x400/1a365d/ffffff?text=Development+Mode"
  : "https://placehold.co/1200x400/1a365d/ffffff?text=Hayden+Westbrook";
---

<Layout 
  title={title}
  description={description}
  canonicalURL={canonicalURL}
>
  <main class="w-full">
    <HeroImage 
      imageUrl={imageUrl}
      altText="Hayden Westbrook"
      height="400px"
      className="w-full mb-16"
      client:visible
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <section class="mb-16 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-primary mb-4">Hayden Westbrook</h1>
        <p class="text-xl md:text-2xl text-text-light">Software Developer & Engineer</p>
      </section>

      <section class="mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6">About Me</h2>
        <About />
      </section>

      <section class="mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6">Projects</h2>
        <ProjectList projects={projects} client:visible />
      </section>

      <section class="mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6">Contact</h2>
        <Contact />
      </section>

      <section class="mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-primary mb-6">Blog</h2>
        <a href="/blog" class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg hover:bg-secondary transition-colors">
          <span>View Blog</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </section>
    </div>
  </main>
</Layout>