---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import ProjectList from '../components/ProjectList/ProjectList';
import HeroImage from '../components/HeroImage/HeroImage';
import { Content as ProjectsContent, frontmatter as projectsData } from '../content/projects.md';

const { projects } = projectsData;
---

<Layout title="Hayden Westbrook - Portfolio">
  <main class="container mx-auto px-4 py-8">
    <HeroImage 
      imageUrl="https://placehold.co/1200x400/1a365d/ffffff?text=Hayden+Westbrook"
      altText="Hayden Westbrook"
      height="400px"
      className="mb-16"
      client:load
    />

    <section class="mb-16 text-center">
      <h1 class="text-4xl font-bold text-primary mb-4">Hayden Westbrook</h1>
      <p class="text-xl text-text-light">Software Developer & Engineer</p>
    </section>

    <section class="mb-16">
      <h2 class="text-3xl font-bold text-primary mb-6">About Me</h2>
      <About />
    </section>

    <section class="mb-16">
      <h2 class="text-3xl font-bold text-primary mb-6">Projects</h2>
      <div class="prose prose-lg max-w-none mb-8">
        <ProjectsContent />
      </div>
      <ProjectList projects={projects} client:load />
    </section>

    <section class="mb-16">
      <h2 class="text-3xl font-bold text-primary mb-6">Contact</h2>
      <Contact />
    </section>
  </main>
</Layout>