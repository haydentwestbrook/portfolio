---
import Layout from '../layouts/Layout.astro';
import { Navigation } from '../components/Navigation/Navigation';
import { ProfileImage } from '../components/ProfileImage/ProfileImage';
import { About } from '../components/About/About';
import { ProjectList } from '../components/ProjectList/ProjectList';
import { Contact } from '../components/Contact/Contact';
import { getCollection } from 'astro:content';
import headshot from '../assets/headshot.webp';

// Fetch projects from content collection
const projects = (await getCollection('projects')).map(entry => ({
  title: entry.data.title,
  description: entry.data.description,
  image: entry.data.image,
  technologies: entry.data.technologies,
  liveUrl: entry.data.liveUrl,
  githubUrl: entry.data.githubUrl,
  date: entry.data.date.toISOString().split('T')[0] // Format date as YYYY-MM-DD
}));

// Fetch contact data from content collection
const contactEntry = await getCollection('contact');
const contactData = contactEntry[0]?.data || {
  title: 'Contact Information',
  email: 'your.email@example.com',
  location: 'Your Location',
  github: 'https://github.com/yourusername',
  linkedin: 'https://linkedin.com/in/yourusername',
  formTitle: 'Get in Touch',
  formDescription: 'Feel free to reach out if you have any questions or opportunities.'
};

// Generate metadata for SEO
const title = "Hayden Westbrook - Portfolio";
const description = "Software Developer & Engineer specializing in web development and software engineering.";

// Handle canonical URL based on environment
let canonicalURL;
try {
  if (Astro.site) {
    canonicalURL = new URL(Astro.url.pathname, Astro.site);
  }
} catch (error) {
  console.warn('Could not generate canonical URL:', error);
}

// Development-specific settings
const isDev = import.meta.env.DEV;
---

<Layout 
  title={title}
  description={description}
  canonicalURL={canonicalURL}
>
  <Navigation client:load />
  
  <main class="pt-16 pb-[16rem]">
    <section id="hero" class="min-h-[calc(100vh-4rem)] flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-4xl mx-auto">
        <ProfileImage
          imageUrl={headshot}
          altText="Hayden's profile picture"
          client:visible
        />
        <h1 class="mt-4 sm:mt-6 md:mt-8 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900">
          Hayden Westbrook
        </h1>
        <p class="mt-2 sm:mt-3 md:mt-4 text-lg sm:text-xl md:text-2xl text-gray-600">
          Full-stack Software Engineer
        </p>
        <div class="mt-4 sm:mt-5 md:mt-6 flex justify-center space-x-4">
          <a
            href="/blog"
            class="inline-flex items-center px-4 py-2 text-base font-medium text-primary hover:text-primary-dark transition-colors"
          >
            <svg
              class="h-5 w-5 mr-2"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
            Blog
          </a>
        </div>
      </div>
    </section>

    <section id="about" class="py-16 px-4 sm:px-6 lg:px-8">
      <About client:visible />
    </section>

    <section id="projects" class="py-16 px-4 sm:px-6 lg:px-8">
      <ProjectList projects={projects} client:visible />
    </section>

    <section id="contact" class="py-16 px-4 sm:px-6 lg:px-8">
      <Contact data={contactData} client:visible />
    </section>
  </main>
</Layout>