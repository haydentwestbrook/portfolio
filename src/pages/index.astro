---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation/Navigation';
import ProfileImage from '../components/ProfileImage/ProfileImage';
import About from '../components/About/About';
import ProjectList from '../components/ProjectList/ProjectList';
import Contact from '../components/Contact/Contact';
import SocialLinks from '../components/SocialLinks/SocialLinks';
import { getCollection } from 'astro:content';
import { readFile } from 'fs/promises';
import { join } from 'path';

// Fetch projects from content collection
const projects = (await getCollection('projects')).map(entry => ({
  title: entry.data.title,
  description: entry.data.description,
  image: entry.data.image,
  technologies: entry.data.technologies,
  liveUrl: entry.data.liveUrl,
  githubUrl: entry.data.githubUrl,
  date: entry.data.date.toISOString().split('T')[0] // Format date as YYYY-MM-DD
}));

// Fetch contact data directly from markdown file
let contactData;
try {
  const contactFilePath = join(process.cwd(), 'src', 'content', 'contact.md');
  const contactFile = await readFile(contactFilePath, 'utf-8');
  const frontmatter = contactFile.split('---')[1];
  const data = Object.fromEntries(
    frontmatter
      .split('\n')
      .filter(line => line.trim())
      .map(line => {
        const [key, ...values] = line.split(':');
        return [key.trim(), values.join(':').trim()];
      })
  );
  
  contactData = {
    title: data.title || 'Contact Information',
    email: data.email || 'your.email@example.com',
    location: data.location || 'Your Location',
    github: data.github || 'https://github.com/yourusername',
    linkedin: data.linkedin || 'https://linkedin.com/in/yourusername',
    formTitle: data.formTitle || 'Get in Touch',
    formDescription: data.formDescription || 'Feel free to reach out if you have any questions or opportunities.'
  };
} catch (error) {
  console.warn('Error reading contact data:', error);
  contactData = {
    title: 'Contact Information',
    email: 'your.email@example.com',
    location: 'Your Location',
    github: 'https://github.com/yourusername',
    linkedin: 'https://linkedin.com/in/yourusername',
    formTitle: 'Get in Touch',
    formDescription: 'Feel free to reach out if you have any questions or opportunities.'
  };
}

// Generate metadata for SEO
const title = "Hayden Westbrook - Portfolio";
const description = "Software Developer & Engineer specializing in web development and software engineering.";

// Handle canonical URL based on environment
let canonicalURL;
try {
  if (Astro.site) {
    canonicalURL = new URL(Astro.url.pathname, Astro.site);
  }
} catch (error) {
  console.warn('Could not generate canonical URL:', error);
}

// Development-specific settings
const isDev = import.meta.env.DEV;
const imageUrl = isDev 
  ? "https://placehold.co/1200x400/1a365d/ffffff?text=Development+Mode"
  : "https://placehold.co/1200x400/1a365d/ffffff?text=Hayden+Westbrook";
---

<Layout 
  title={title}
  description={description}
  canonicalURL={canonicalURL}
>
  <Navigation client:load />
  
  <main class="pt-16">
    <section id="hero" class="min-h-screen flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <ProfileImage
          imageUrl="/headshot.jpg"
          altText="Hayden's profile picture"
          size="400px"
          client:load
        />
        <h1 class="mt-8 text-4xl sm:text-5xl md:text-6xl font-bold text-gray-900">
          Hayden
        </h1>
        <p class="mt-4 text-xl sm:text-2xl text-gray-600">
          Software Engineer
        </p>
        <div class="mt-6 flex justify-center space-x-4">
          <SocialLinks />
          <a
            href="/blog"
            class="inline-flex items-center px-4 py-2 text-base font-medium text-primary hover:text-primary-dark transition-colors"
          >
            <svg
              class="h-5 w-5 mr-2"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
            Blog
          </a>
        </div>
      </div>
    </section>

    <About client:load />
    <ProjectList projects={projects} client:load />
    <Contact data={contactData} client:load />
  </main>
</Layout>