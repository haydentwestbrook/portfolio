---
import Layout from "../layouts/Layout.astro";
import { Content as About } from "../content/about.md";
import { Content as Contact } from "../content/contact.md";
import { Content as Projects } from "../content/projects.md";
import ProjectList from "../components/ProjectList/ProjectList";

// Define an array of projects
const projects = [
  {
    name: "Project One",
    description: "Description of Project One.",
    link: "https://example.com/project-one",
    image: "/images/project-one.jpg",
  },
  {
    name: "Project Two",
    description: "Description of Project Two.",
    link: "https://example.com/project-two",
    image: "/images/project-two.jpg",
  },
  // Add more projects as needed
];
---

<Layout>
  <main>
    <section>
      <About />
    </section>
    <section>
      <ProjectList projects={projects} client:load />
    </section>
  </main>
  <aside>
    <Contact />
  </aside>
</Layout>
