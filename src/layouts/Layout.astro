---
import "../styles/global.css";
import '../styles/theme.css';
import { Footer } from '../components/Footer/Footer';

interface Props {
  title: string;
  description: string;
  canonicalURL?: URL;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  modifiedDate?: Date;
  author?: string;
  tags?: string[];
}

const {
  title,
  description,
  canonicalURL,
  image,
  type = 'website',
  pubDate,
  modifiedDate,
  author,
  tags = []
} = Astro.props;

const siteTitle = "Hayden Westbrook";
const fullTitle = `${title} | ${siteTitle}`;
const defaultImage = new URL('/og-image.jpg', Astro.site).toString();
const ogImage = image || defaultImage;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Preload critical assets -->
    <style>
      @font-face {
        font-family: 'Inter var';
        font-weight: 100 900;
        font-display: swap;
        font-style: normal;
        font-named-instance: 'Regular';
      }
    </style>

    <!-- Canonical URL -->
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL?.toString() || Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL?.toString() || Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Article specific meta tags -->
    {type === 'article' && (
      <>
        {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
        {modifiedDate && <meta property="article:modified_time" content={modifiedDate.toISOString()} />}
        {author && <meta property="article:author" content={author} />}
        {tags.map((tag: string) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
  </head>
  <body class="min-h-screen bg-background text-text">
    <slot />
    <Footer client:visible />
  </body>
</html>
